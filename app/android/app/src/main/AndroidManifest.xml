<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links (verificate cu https://www.adelaharu.ro/.well-known/assetlinks.json, din fragmentul
                 ah-sp-aplicatie.php): Spațiul meu (și linkul personal ?cont= din emailuri) și /app/intra
                 deschid aplicația; App.addListener('appUrlOpen') din punte duce WebView-ul acolo. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.adelaharu.ro" />
                <!-- aceleași căi ca ah_spa_aasa() pe iOS: /spatiul-meu, /spatiul-meu/*, /app/intra, /app/intra/*
                     (path exact + pathPrefix cu „/”, ca să nu prindă și /spatiul-meu-altceva) -->
                <data android:path="/spatiul-meu" />
                <data android:pathPrefix="/spatiul-meu/" />
                <data android:path="/app/intra" />
                <data android:pathPrefix="/app/intra/" />
                <!-- pagina partenerului (ah-sp-partener.php): linkul /pentru-el/?t= din emailul lui; aceleași căi în AASA -->
                <data android:path="/pentru-el" />
                <data android:pathPrefix="/pentru-el/" />
            </intent-filter>
        </activity>

        <!-- AhMedia: meditația din WebView ține aplicația vie cu ecranul blocat și are comenzi în notificare -->
        <service
            android:name=".AhMediaService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
        />

        <!-- Widgetul de pe ecranul principal (AhWidget): „Meditația zilei sau faza ciclului”. exported=false: APPWIDGET_UPDATE
             vine de la sistem (AppWidgetService), care ajunge și la receiverele neexportate; alte aplicații nu-l pot chema
             (ca în exemplul actual din documentația Android pentru widgeturi). -->
        <receiver
            android:name=".AhWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/ah_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Firebase (doar pentru notificările push, cu google-services.json): tokenul FCM se face abia după ce ea
             permite notificările (PushNotifications.register() pornește singur auto-init), nu la prima deschidere.
             Fără Google Analytics pentru Firebase. Fără google-services.json aceste chei nu au niciun efect. -->
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_deactivated" android:value="true" />
        <!-- pictograma notificărilor push (FCM): lotusul alb, monocrom (altfel Android pune un pătrat alb); culoarea, din mesaj -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/ic_stat_lotus" />
        <meta-data android:name="com.google.firebase.messaging.default_notification_color" android:resource="@color/ah_accent" />
        <!-- canalul notificărilor push fără channel_id în mesaj: ah_clopotel (sunetul clopotel.wav), creat din JS de puntea
             site-ului (LocalNotifications.createChannel). Dacă încă nu există (aplicația abia instalată), Firebase folosește
             singur canalul lui de rezervă („Diverse”), deci cheia e sigură și înainte de crearea canalului. -->
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="ah_clopotel" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- serviciul de prim-plan pentru redarea meditațiilor (AhMediaService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- notificările locale ale fazelor ciclului la ora exactă (Android ≤ 12); fără ea, Android le poate întârzia puțin -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 7–10 (SDK ≤ 29): @capacitor/file-transfer cere permisiunea de stocare la downloadFile chiar și în folderul
         aplicației (Directory.DATA); de la Android 11 nu mai e nevoie și nu se mai cere -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
</manifest>
