<?xml version="1.0" encoding="utf-8"?>
<!-- Widgetul „Adela Haru” (AhWidget): 2×2, redimensionabil până la 4×2 și mai mult.
     updatePeriodMillis = 6 h: doar ca să treacă singur pe starea neutră când datele au peste 36 h (AhWidgetDate.deArata);
     conținutul nou vine din aplicație (AhApp.widget → AhWidget.actualizeazaToate), nu de pe internet. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/ah_widget_descriere"
    android:initialLayout="@layout/ah_widget_neutru"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="260dp"
    android:previewImage="@drawable/ah_widget_previzualizare"
    android:previewLayout="@layout/ah_widget_neutru"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="21600000"
    android:widgetCategory="home_screen" />
