<?xml version="1.0" encoding="utf-8"?>
<!-- Android ≤ 11 (fullBackupContent; contează doar dacă allowBackup ar fi pornit): aceleași excluderi ca
     data_extraction_rules.xml — Preferences (CapacitorStorage), datele WebView (app_webview, în root), fișierele. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="root" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
