<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2: lotusul în culoarea dată, titlul (serif), textul și „Adela Haru”. Fără poză. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ah_w_radacina"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ah_widget_fundal"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ah_w_semn"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ah_widget_lotus" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ah_w_titlu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="3"
        android:textColor="@color/ah_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/ah_w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/ah_text_bland"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.1"
        android:text="@string/ah_widget_semnatura"
        android:textColor="@color/ah_text_bland"
        android:textSize="10sp" />
</LinearLayout>
