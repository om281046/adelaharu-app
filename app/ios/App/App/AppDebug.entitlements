<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Debug (Run din Xcode pe un telefon): APNs de dezvoltare. Release: App.entitlements (production). -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.adelaharu.ro</string>
	</array>
	<!-- widgetul de pe ecranul principal (AdelaHaruWidget) citește datele scrise de aplicație din acest grup -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ro.adelaharu.app</string>
	</array>
</dict>
</plist>
