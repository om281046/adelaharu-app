<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Widgetul citește datele scrise de aplicație (AhWidgetDate) din App Group-ul comun. Același grup în
     App.entitlements și AppDebug.entitlements; grupul se creează în Apple Developer (app/README.md, „Widgetul”). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ro.adelaharu.app</string>
	</array>
</dict>
</plist>
